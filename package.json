{
	"name": "gateway-api-visualizer",
	"private": true,
	"version": "0.2.0",
	"description": "Visualize Kubernetes Gateway API resource coverage (Gateways -> Routes) from local YAML.",
	"type": "module",
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build && bash ./scripts/post-build.sh",
		"deploy": "vite build && bash ./scripts/post-build.sh",
		"preview": "vite preview",
		"lint": "oxlint src/ --tsconfig tsconfig.json",
		"typecheck": "tsgo --project tsconfig.json --noEmit",
		"format": "prettier --write .",
		"test": "vitest --run"
	},
	"dependencies": {
		"cytoscape": "^3.34.3",
		"js-yaml": "^5.4.2",
		"monaco-editor": "0.52.2",
		"monaco-yaml": "^5.5.1",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^25.5.2",
		"@typescript/native-preview": "7.0.0-dev.20260501.1",
		"autoprefixer": "^10.6.1",
		"oxlint": "^1.73.0",
		"postcss": "^8.5.28",
		"prettier": "^3.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"overrides": {
			"vite>esbuild": "-"
		},
		"packageExtensions": {
			"monaco-editor@0.52.2": {
				"dependencies": {
					"dompurify": "^3.4.15"
				}
			}
		},
		"patchedDependencies": {
			"monaco-editor@0.52.2": "patches/monaco-editor@0.52.2.patch"
		}
	}
}
